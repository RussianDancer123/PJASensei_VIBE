{
	auto_https off
	admin off
}

:80 {
	# Development routes, present only when compose.dev.yaml mounts them.
	import /etc/caddy/dev.d/*.caddy

	# The front end is static files, so the settings it needs for sign-in reach it from here.
	handle /config.json {
		header Content-Type application/json
		respond `{"issuer":"{$IDENTITY_ISSUER}","clientId":"{$IDENTITY_CLIENT_ID}","frameAncestors":"{$FRAME_ANCESTORS}"}`
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {$SPRING_ADDRESS}
	}

	handle {
		header Content-Security-Policy "frame-ancestors {$FRAME_ANCESTORS}"
		reverse_proxy {$FRONTEND_ADDRESS}
	}
}
