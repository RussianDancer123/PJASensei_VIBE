# Local development values, used as is by `docker compose --env-file .env.example up --build`.
# To change anything, copy this file to .env and run `docker compose up --build`.

# Adds the development mocks. A server's environment file leaves these two lines out.
COMPOSE_FILE=compose.yaml:compose.dev.yaml
COMPOSE_PATH_SEPARATOR=:

# Published on the host: the only two ways in from outside Compose.
CADDY_HTTP_PORT=8080
GITEA_SSH_PORT=2222

# The host name in the SSH addresses Students clone from.
GITEA_SSH_DOMAIN=localhost

# Addresses inside the Compose network.
FRONTEND_ADDRESS=frontend:80
SPRING_ADDRESS=spring:8080
POSTGRES_ADDRESS=postgres:5432
GITEA_API_URL=http://gitea:3000
MOCKS_ADDRESS=mocks:8090

# Who may call the API from another origin (comma-separated) and who may embed the front end
# (space-separated CSP sources). The plugin mock shares Caddy's origin, so it needs neither.
CORS_ALLOWED_ORIGINS=
FRAME_ANCESTORS="'self'"

# The identity provider, here the mock. The issuer is its public address, compared with tokens and
# used by browsers. Spring fetches the signing keys from their own address, because the public one
# does not resolve inside the Compose network. With real Cognito both are the same public address.
IDENTITY_ISSUER=http://localhost:${CADDY_HTTP_PORT}/mock-idp
IDENTITY_JWK_SET_URI=http://${MOCKS_ADDRESS}/mock-idp/.well-known/jwks.json
IDENTITY_CLIENT_ID=pjasensei-local

# Which groups in a token give a role: a number plus one of these suffixes, so 17w is an Instructor
# group and 17c is its paired ClassGroup. Any other group is ignored.
INSTRUCTOR_GROUP_SUFFIX=w
CLASS_GROUP_SUFFIX=c

# The Cognito API, which Refresh reads Students and emails from. The endpoint override sends those
# calls to the mock; with real Cognito it stays empty. The mock accepts any credentials.
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=eu-central-1_mock
COGNITO_ACCESS_KEY_ID=mock-access-key
COGNITO_SECRET_ACCESS_KEY=mock-secret-key
COGNITO_ENDPOINT_OVERRIDE=http://${MOCKS_ADDRESS}/mock-idp/cognito-api

# Which hosts a SourceRepository may be on (comma-separated). Spring and Gitea both enforce this.
SOURCE_REPOSITORY_HOSTS=github.com

# Application database. A local development value: never reuse it on a real server.
POSTGRES_DB=pjasensei
POSTGRES_USER=pjasensei
POSTGRES_PASSWORD=local-development-only
